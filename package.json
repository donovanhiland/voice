{
  "name": "voice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build a personal writing skill from your message exports, guided by your agent.",
  "scripts": {
    "voice": "bun run src/cli.ts",
    "test": "bun test",
    "check": "tsc --noEmit",
    "demo": "bun run src/cli.ts demo",
    "format": "prettier --write src tests docs *.md *.json .github/workflows/*.yml",
    "format:check": "prettier --check src tests docs *.md *.json .github/workflows/*.yml"
  },
  "devDependencies": {
    "@types/bun": "1.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
